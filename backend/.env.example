# =============================================================================
# Bharat Voice AI — Backend Environment Variables
# Copy this file to .env.local and fill in your actual API keys.
# =============================================================================

# -----------------------------------------------------------------------------
# LiveKit (Real-time audio transport)
# Get these from https://cloud.livekit.io/ → your project → Settings
# -----------------------------------------------------------------------------
LIVEKIT_URL=wss://your-project.livekit.cloud
LIVEKIT_API_KEY=your_livekit_api_key_here
LIVEKIT_API_SECRET=your_livekit_api_secret_here

# -----------------------------------------------------------------------------
# Murf AI (TTS — Text-to-Speech via Murf Falcon)
# Get your API key from https://murf.ai/api/dashboard
# -----------------------------------------------------------------------------
MURF_API_KEY=your_murf_api_key_here

# Voice Options on Murf Falcon (India):
#   - Pooja   : Indian Female Voice (Default - English & Hindi fluent)
#   - Samar   : Indian Male Voice (English & Hindi fluent)
#   - Anisha  : Indian Female Voice
#   - female  : Shortcut for Pooja
#   - male    : Shortcut for Samar
MURF_VOICE=Pooja
MURF_LOCALE=en-IN
MURF_STYLE=Conversation

# -----------------------------------------------------------------------------
# Deepgram (STT — Speech-to-Text)
# Get your API key from https://console.deepgram.com/
# -----------------------------------------------------------------------------
DEEPGRAM_API_KEY=your_deepgram_api_key_here
DEEPGRAM_MODEL=nova-3

# -----------------------------------------------------------------------------
# Google Gemini (LLM — Language Model)
# Get your API key from https://aistudio.google.com/apikey
# -----------------------------------------------------------------------------
GOOGLE_API_KEY=your_google_api_key_here
GEMINI_MODEL=gemini-2.0-flash

# -----------------------------------------------------------------------------
# Agent Configuration
# -----------------------------------------------------------------------------
AGENT_NAME=bharat-voice-ai

# -----------------------------------------------------------------------------
# Telephony & Outbound Calls (LiveKit SIP & Linphone Integration)
# -----------------------------------------------------------------------------
LIVEKIT_SIP_OUTBOUND_TRUNK_ID=ST_B4bMBK9TtaqH
SIP_TRUNK_ID=ST_B4bMBK9TtaqH
SIP_TRUNK_HOSTNAME=sip.linphone.org
LINPHONE_USERNAME=gautammax
LINPHONE_DOMAIN=sip.linphone.org
LINPHONE_SIP_URI=sip:gautammax@sip.linphone.org

SIP_AUTH_USERNAME=gautammax
SIP_AUTH_PASSWORD=
OUTBOUND_PHONE_NUMBER=sip:gautammax@sip.linphone.org
OUTBOUND_TEST_PHONE_NUMBER=sip:gautammax@sip.linphone.org
OUTBOUND_TEST_MODE=true

WEATHER_ALERT_RAIN_THRESHOLD=70
OUTBOUND_CALL_START_HOUR=8
OUTBOUND_CALL_END_HOUR=20
OUTBOUND_MAX_RETRIES=0


